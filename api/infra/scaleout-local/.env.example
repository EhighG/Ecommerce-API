# 이 파일을 같은 폴더의 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
# 실행 절차는 docs/operations.md의 "로컬 수평 확장"에 있다.

MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

GCP_PROJECT_ID=
GCS_BUCKET=
GCS_UPLOAD_PREFIX=

LOADTEST_AUTH_ENABLED=
LOADTEST_AUTH_SECRET=

# 호스트의 GCP 자격 증명 파일 경로와, 컨테이너 안에서 그 파일을 둘 경로
GOOGLE_ADC_HOST_PATH=
GOOGLE_ADC_CONTAINER_PATH=
