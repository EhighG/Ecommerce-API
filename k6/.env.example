# 이 파일을 k6/.env로 복사해 값을 채운다. k6/.env는 커밋하지 않는다.
# 같은 이름의 환경변수(k6 run -e KEY=값)가 있으면 그 값이 먼저다.

# 대상 서버의 API 기본 주소. /api까지 포함한다(예: http://localhost:8081/api).
BASE_URL=

# 로그인 방식 스크립트가 쓰는 테스트 계정 공통 비밀번호. 가입 비밀번호 정책(docs/security.md)을 만족해야 한다.
PASSWORD=

# 헤더 우회 방식(260519_order_bypass_auth) 스크립트가 쓰는 부하테스트 비밀값. 대상 서버의 LOADTEST_AUTH_SECRET과 같은 값.
LOADTEST_AUTH_SECRET=
